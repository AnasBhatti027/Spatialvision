{
  "expo": {
    "name": "SpatialVision",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "backgroundColor": "#161F2D"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.szabist.spatialvision",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      [
        "expo-mediapipe",
        {
          "modelsDir": "./assets/models"
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-emblem-light-mode.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6FC",
          "dark": {
            "image": "./assets/brand/splash-emblem-dark-mode.png",
            "backgroundColor": "#080B16"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f938e930-b3af-491e-baa5-1338e7ea7a8b"
      }
    }
  }
}
